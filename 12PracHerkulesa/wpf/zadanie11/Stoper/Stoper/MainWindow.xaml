<Window x:Class="Stoper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stoper, wykonał: 001"
        Height="520" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Czas -->
        <TextBlock Grid.Row="0"
                   x:Name="txtCzas"
                   Text="00:00.0"
                   FontFamily="Consolas"
                   FontSize="48"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <!-- Przyciski -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="btnStart"
                    Content="Start"
                    Width="100"
                    Height="36"
                    Margin="0,0,10,0"
                    Background="LimeGreen"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Click="btnStart_Click"/>

            <Button x:Name="btnMiedzyczas"
                    Content="Międzyczas"
                    Width="100"
                    Height="36"
                    Margin="0,0,10,0"
                    IsEnabled="False"
                    Click="btnMiedzyczas_Click"/>

            <Button x:Name="btnReset"
                    Content="Reset"
                    Width="100"
                    Height="36"
                    IsEnabled="False"
                    Click="btnReset_Click"/>
        </StackPanel>

        <!-- Lista międzyczasów -->
        <ListBox Grid.Row="4"
                 x:Name="lstMiedzyczasy"
                 FontFamily="Consolas"
                 FontSize="14"/>

        <!-- Najszybsze okrążenie -->
        <TextBlock Grid.Row="6"
                   x:Name="txtNajszybsze"
                   Text="Najszybsze okrążenie: –"
                   FontSize="14"
                   HorizontalAlignment="Center"/>
    </Grid>
</Window>