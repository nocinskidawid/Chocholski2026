<Window x:Class="GeneratorHasel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nowy pracownik, wykonał: 001"
        Height="420" Width="620"
        Background="#E0F2F1"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEWA KOLUMNA - Dane pracownika -->
            <GroupBox Grid.Column="0" Header="Dane pracownika" Padding="15">
                <StackPanel>
                    <TextBlock Text="Imię" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtImie" Height="28" Padding="5,3" Margin="0,0,0,12"/>

                    <TextBlock Text="Nazwisko" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtNazwisko" Height="28" Padding="5,3" Margin="0,0,0,12"/>

                    <TextBlock Text="Stanowisko" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbStanowisko" Height="28" SelectedIndex="0">
                        <ComboBoxItem Content="Kierownik"/>
                        <ComboBoxItem Content="Starszy programista"/>
                        <ComboBoxItem Content="Młodszy programista"/>
                        <ComboBoxItem Content="Tester"/>
                    </ComboBox>
                </StackPanel>
            </GroupBox>

            <!-- PRAWA KOLUMNA - Generowanie hasła -->
            <GroupBox Grid.Column="2" Header="Generowanie hasła" Padding="15">
                <StackPanel>
                    <TextBlock Text="Ile znaków?" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtIleZnakow" Height="28" Padding="5,3" Margin="0,0,0,12" Width="100" HorizontalAlignment="Left"/>

                    <CheckBox x:Name="chkMaleWielkie" Content="Małe i wielkie litery" IsChecked="True" Margin="0,0,0,8"/>
                    <CheckBox x:Name="chkCyfry" Content="Cyfry" Margin="0,0,0,8"/>
                    <CheckBox x:Name="chkZnakiSpecjalne" Content="Znaki specjalne" Margin="0,0,0,15"/>

                    <Button x:Name="btnGenerujHaslo" 
                            Content="Generuj hasło" 
                            Height="30" 
                            Click="btnGenerujHaslo_Click"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Przycisk Zatwierdź -->
        <Button Grid.Row="2"
                x:Name="btnZatwierdz"
                Content="Zatwierdź"
                Width="140"
                Height="36"
                Background="#00695C"
                Foreground="White"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                Click="btnZatwierdz_Click"/>
    </Grid>
</Window>