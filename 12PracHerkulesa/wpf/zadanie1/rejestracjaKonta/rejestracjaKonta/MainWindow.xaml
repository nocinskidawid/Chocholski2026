<Window x:Class="RejestracjaKonta.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rejestracja konta, wykonał: 001"
        Height="600" Width="400"
        Background="#E3F2FD"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <TextBlock Grid.Row="0" 
                   Text="Utwórz konto" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center"/>

        <!-- E-mail -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="E-mail" Margin="0,0,0,4"/>
            <TextBox x:Name="txtEmail" Height="28" Padding="5,3"/>
        </StackPanel>

        <!-- Hasło -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="Hasło" Margin="0,0,0,4"/>
            <PasswordBox x:Name="txtHaslo" Height="28" Padding="5,3"/>
        </StackPanel>

        <!-- Powtórz hasło -->
        <StackPanel Grid.Row="6">
            <TextBlock Text="Powtórz hasło" Margin="0,0,0,4"/>
            <PasswordBox x:Name="txtPowtorzHaslo" Height="28" Padding="5,3"/>
        </StackPanel>

        <!-- Przycisk -->
        <Button Grid.Row="8" 
                x:Name="btnZatwierdz" 
                Content="Zatwierdź" 
                Width="120" 
                Height="32"
                HorizontalAlignment="Center"
                Click="btnZatwierdz_Click"/>

        <!-- Komunikat -->
        <TextBlock Grid.Row="10" 
                   x:Name="txtKomunikat" 
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Text=""/>
    </Grid>
</Window>