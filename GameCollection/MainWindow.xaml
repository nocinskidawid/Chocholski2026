<Window x:Class="GameCollection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameCollection"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0">
            <TextBlock Text="Title:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="titleBox" Width="180" Margin="0,0,12,0"/>
            <TextBlock Text="Genre:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="genreBox" Width="120" Margin="0,0,12,0"/>
            <TextBlock Text="Rating:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="ratingBox" Width="50" Margin="0,0,12,0"/>
            <Button Content="Add" Width="80" Click="AddButton_Click"/>
            <Button Content="Usun" Width="80" Click="Button_Click"/>
            <Button Content="Toogle" Width="80" Click="Button_Click_1"/>
        </StackPanel>
        
        <DataGrid Grid.Row="1" x:Name="gamesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Gatunek" Binding="{Binding Genre}" Width="150"/>
                <DataGridTextColumn Header="Rating" Binding="{Binding Rating}" Width="80"/>
                <DataGridCheckBoxColumn Header="Completed" Binding="{Binding Completed}" Width="100"/>
            </DataGrid.Columns>
            
        </DataGrid>
    </Grid>
</Window>
